# fetchpdf contact address for Unpaywall and Crossref.
# Without EMAIL, unpaywall cannot be use. 
EMAIL=you@email.com
CROSSREFEMAIL=you@email.com

# Optional provider keys. Leave blank to use anonymous access tiers.
# OpenAlex: avoids 429 rate-limit errors
# Semantic Scholar：1 -> 100 req/s
# NCBI E-utils: 3 -> 10 req/s
# Core: daily quota, not a rate: 500 requests/day
# Without ELSEVIER_TDM_API_KEY, Elsevier DOIs fall through to the open-access routes like any other publisher.
OPENALEXAPIKEY=
SEMANTIC_SCHOLAR_API_KEY=
ENTREZ_EUTILS_API_KEY=
COREAPIKEY=
SCOPUS_API_KEY=
ELSEVIER_TDM_API_KEY=
